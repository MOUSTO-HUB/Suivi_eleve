# Copier ce fichier en .env puis adapter les valeurs.

# --- Base de données (docker-compose) ---
POSTGRES_USER=suivi
POSTGRES_PASSWORD=suivi_dev
POSTGRES_DB=suivi_eleve
POSTGRES_PORT=5432
DATABASE_URL=postgresql://suivi:suivi_dev@localhost:5432/suivi_eleve?schema=public

# --- Redis (files d'envoi) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3100
# Plusieurs origines possibles, séparées par des virgules (ex. version navigateur du mobile).
WEB_ORIGIN=http://localhost:3001,http://localhost:8090

# --- Web (Next.js) : appels serveur vers l'API (jamais exposé au navigateur) ---
API_URL=http://localhost:3100/api

# --- Mobile (Expo) ---
# Sur un téléphone physique, remplacer localhost par l'adresse IP du PC.
EXPO_PUBLIC_API_URL=http://localhost:3100/api

# --- Authentification ---
# Au moins 32 caractères aléatoires. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-une-valeur-aleatoire-de-48-caracteres
# Mot de passe des comptes du personnel créés par pnpm db:seed
SEED_MOT_DE_PASSE=Suivi-Dev-2026

# --- Appareils ---
# Lien imprimé dans les QR codes des étiquettes (page de scan du site web)
WEB_URL=http://localhost:3001
# Nombre de signalements « usage en classe » par mois qui crée un comportement (0 = jamais)
SEUIL_USAGE_APPAREIL_MOIS=3
# Dossier des photos (relatif au dossier api/)
STOCKAGE_DIR=stockage

# --- Notifications (moteur d'envoi) ---
# Fournisseurs : console (logs, développement), orange, twilio | brevo | fcm
SMS_FOURNISSEUR=console
# Bascule automatique si le principal échoue (facultatif), ex. twilio
SMS_FOURNISSEUR_SECOURS=
EMAIL_FOURNISSEUR=console
PUSH_FOURNISSEUR=console
# Essais par envoi et délai avant le 2e essai (doublé ensuite)
NOTIFICATIONS_ESSAIS=3
NOTIFICATIONS_DELAI_ESSAI_MS=30000
# non = l'API met en file sans envoyer (traitement dans un autre processus)
NOTIFICATIONS_TRAITEMENT=oui
# SMS non obligatoires par mois (0 = illimité) et coût estimé d'un SMS en FCFA
SMS_PLAFOND_MENSUEL=0
SMS_COUT_FCFA=
# Accusés de livraison : URL publique de l'API et secret ajouté aux webhooks
API_URL_PUBLIQUE=
WEBHOOK_SECRET=
# Orange SMS API (https://developer.orange.com)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_NUMERO_EXPEDITEUR=
ORANGE_NOM_EXPEDITEUR=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO_EXPEDITEUR=
# Brevo (email)
BREVO_API_KEY=
EMAIL_EXPEDITEUR=
EMAIL_NOM_EXPEDITEUR=Suivi_eleve
# Firebase Cloud Messaging (compte de service)
FCM_PROJET_ID=
FCM_EMAIL_COMPTE_SERVICE=
FCM_CLE_PRIVEE=
# Web Push : notifications du site installé (PC, Android, iPhone). Clés : node dist/cli/cles-vapid.js
# (développement : pnpm --filter @suivi-eleve/api exec tsx src/cli/cles-vapid.ts). Sans clés : désactivé.
VAPID_CLE_PUBLIQUE=
VAPID_CLE_PRIVEE=
# Contact exigé par les services push (mailto:… ou https://…)
VAPID_SUJET=

# --- Abonnements des écoles (site) ---
# Contact affiché à la direction pour renouveler l'abonnement
CONTACT_ABONNEMENT=
# Pays proposé d'abord aux parents à la connexion (site) : GN, CI ou SN
PAYS_PAR_DEFAUT=GN
