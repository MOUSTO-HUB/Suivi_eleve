# Copier ce fichier en .env puis adapter les valeurs.

# --- Base de données (docker-compose) ---
POSTGRES_USER=suivi
POSTGRES_PASSWORD=suivi_dev
POSTGRES_DB=suivi_eleve
POSTGRES_PORT=5432
DATABASE_URL=postgresql://suivi:suivi_dev@localhost:5432/suivi_eleve?schema=public

# --- Redis (files d'envoi) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:3001

# --- Web (Next.js) : appels serveur vers l'API (jamais exposé au navigateur) ---
API_URL=http://localhost:3000/api

# --- Mobile (Expo) ---
# Sur un téléphone physique, remplacer localhost par l'adresse IP du PC.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# --- Authentification ---
# Au moins 32 caractères aléatoires. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-une-valeur-aleatoire-de-48-caracteres
# console = SMS écrits dans les logs de l'API (développement uniquement)
SMS_FOURNISSEUR=console
# Mot de passe des comptes du personnel créés par pnpm db:seed
SEED_MOT_DE_PASSE=Suivi-Dev-2026
