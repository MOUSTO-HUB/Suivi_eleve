{
  "expo": {
    "name": "Suivi_eleve",
    "slug": "suivi-eleve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suivieleve.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#193cb8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.suivieleve.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "suivieleve",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à lire l'étiquette QR des appareils des élèves.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1d4ed8"
        }
      ]
    ]
  }
}
