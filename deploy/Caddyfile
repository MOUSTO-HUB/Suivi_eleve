# Serveur seul (profil « autonome » de docker-compose.prod.yml) : Caddy obtient et renouvelle le
# certificat HTTPS du domaine. Sur le VPS partagé, c'est le frontal commun (dépôt serveur-vps,
# frontal/caddy/sites/suivi-eleve.caddy) qui sert Suivi_eleve.
{$DOMAINE} {
	encode zstd gzip

	# API (application mobile, webhooks des fournisseurs SMS / email).
	handle /api/* {
		reverse_proxy api:3100
	}

	# Site : administration et espace parents.
	handle {
		reverse_proxy web:3001
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format console
	}
}

www.{$DOMAINE} {
	redir https://{$DOMAINE}{uri} permanent
}
