# Certificat HTTPS obtenu et renouvelé automatiquement pour le domaine.
{$DOMAINE} {
	encode zstd gzip

	# API (application mobile, webhooks des fournisseurs SMS / email).
	handle /api/* {
		reverse_proxy api:3100
	}

	# Site : administration et espace parents.
	handle {
		reverse_proxy web:3001
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# FactuPlus (autre application du même serveur, hors Docker) : Caddy obtient son certificat HTTPS
# et lui transmet les visiteurs. FactuPlus écoute sur le port interne 8088 du serveur, joignable
# depuis Docker seulement (voir docs/DEPLOIEMENT.md, « Cohabitation avec FactuPlus »).
factuplus.site {
	encode zstd gzip
	reverse_proxy host.docker.internal:8088
}
