# Production : copier en .env.production sur le serveur (jamais dans Git) et remplir.
# Voir docs/DEPLOIEMENT.md. Les adresses internes (base, Redis, API) sont fixées
# dans docker-compose.prod.yml.

# --- Domaine (le DNS doit pointer vers le serveur ; HTTPS automatique) ---
DOMAINE=suivi.mon-ecole.sn

# --- Base de données ---
POSTGRES_USER=suivi
# Générer : openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=suivi_eleve

# --- Authentification ---
# Générer : openssl rand -base64 48
JWT_SECRET=

# --- Sauvegardes chiffrées (dossier ./sauvegardes) ---
# Phrase secrète de chiffrement : à conserver HORS du serveur (sans elle, aucune restauration).
SAUVEGARDE_PHRASE=
# Heure de la sauvegarde quotidienne (heure de Dakar) et durée de conservation
SAUVEGARDE_HEURE=02
SAUVEGARDE_JOURS=14

# --- Appareils ---
SEUIL_USAGE_APPAREIL_MOIS=3

# --- Notifications : en production, les fournisseurs « console » sont refusés ---
# Phase d'essai sans comptes SMS/email/push : ENVOIS_SIMULES=oui et les trois
# fournisseurs à console. Rien ne part : messages et codes de connexion des parents
# sont écrits dans les logs (suivi logs api | grep 'connexion est'). À retirer
# avant d'accueillir de vraies familles.
ENVOIS_SIMULES=non
SMS_FOURNISSEUR=orange
SMS_FOURNISSEUR_SECOURS=twilio
EMAIL_FOURNISSEUR=brevo
PUSH_FOURNISSEUR=fcm
NOTIFICATIONS_ESSAIS=3
NOTIFICATIONS_DELAI_ESSAI_MS=30000
NOTIFICATIONS_TRAITEMENT=oui
SMS_PLAFOND_MENSUEL=0
SMS_COUT_FCFA=
# Secret ajouté aux URL des accusés de livraison. Générer : openssl rand -hex 24
WEBHOOK_SECRET=

ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_NUMERO_EXPEDITEUR=
ORANGE_NOM_EXPEDITEUR=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO_EXPEDITEUR=
BREVO_API_KEY=
EMAIL_EXPEDITEUR=
EMAIL_NOM_EXPEDITEUR=Suivi_eleve
FCM_PROJET_ID=
FCM_EMAIL_COMPTE_SERVICE=
FCM_CLE_PRIVEE=

# --- Web Push : notifications du site installé (PC, Android, iPhone) ---
# Générer une fois : suivi run --rm api node dist/cli/cles-vapid.js
VAPID_CLE_PUBLIQUE=
VAPID_CLE_PRIVEE=
# Contact exigé par les services push : mailto:votre-adresse
VAPID_SUJET=

# --- Abonnements des écoles ---
# Affiché à la direction des écoles pour renouveler (téléphone, WhatsApp, email…)
CONTACT_ABONNEMENT=
# Pays proposé d'abord aux parents à la connexion : GN, CI ou SN
PAYS_PAR_DEFAUT=GN
